          </surface>
        </newparam>
        <newparam sid="Image_0_002-sampler">
          <sampler2D>
            <source>Image_0_002-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Image_0_002-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
